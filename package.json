{
  "name": "opencode-9router-plugin",
  "version": "0.2.0",
  "description": "Dynamic 9router provider plugin for opencode (v1 + v2 compatible)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "opencode-9router-plugin": "dist/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rimraf dist",
    "mock": "node scripts/mock-9router.mjs",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [
    "opencode",
    "plugin",
    "9router",
    "ai"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@opencode/plugin": "^2.0.16"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "rimraf": "^6.1.0",
    "typescript": "^5.8.2"
  }
}
